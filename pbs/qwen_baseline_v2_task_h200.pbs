#!/bin/bash
#PBS -P hn98
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l jobfs=20GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/jp09
#PBS -l wd

set -euo pipefail

: "${TASK:?TASK is required}"
: "${PREFIX:?PREFIX is required}"

cd /scratch/jp09/dd9648/video-hallucination-benchmark

export QWEN25_VL_MODEL_DIR=/scratch/jp09/dd9648/huggingface/models--Qwen--Qwen2.5-VL-7B-Instruct/snapshots/cc594898137f460bfe9f0759e9844b3ce807cfb5
export MODEL_DIR="$QWEN25_VL_MODEL_DIR"
export HF_HOME=/scratch/jp09/dd9648/huggingface
export HF_HUB_CACHE=/scratch/jp09/dd9648/huggingface
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONPATH=.
export OMP_NUM_THREADS="$PBS_NCPUS"

test -f "$MODEL_DIR/config.json"

echo "Node:   $(hostname)"
echo "Task:   videohallucer/$TASK"
echo "Prefix: $PREFIX"
echo "Resume: false"

nvidia-smi

cat > "/tmp/${PREFIX}.yaml" <<YAML
name: ${PREFIX}
seed: 42
models:
  - qwen2.5-vl-7b
methods:
  - base
benchmarks:
  - name: videohallucer
    tasks:
      - ${TASK}
sampling: configs/sampling.yaml
generation:
  max_new_tokens: 128
  do_sample: false
  temperature: 0.0
  num_beams: 1
output_dir: results/raw
manifest_dir: manifests
resume: false
YAML

./.venv/bin/python scripts/run_benchmark.py \
  --config "/tmp/${PREFIX}.yaml" \
  --debug-errors

echo "TASK COMPLETE: videohallucer/$TASK"
