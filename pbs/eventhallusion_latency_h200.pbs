#!/bin/bash
#PBS -P hn98
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l jobfs=20GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/jp09
#PBS -l wd

set -euo pipefail

: "${MODEL:?Set MODEL to qwen2.5-vl-7b, llava-ov-7b, or llava-video-7b}"
: "${METHOD:?Set METHOD to base, tcd, dino_heal, season, or positive_feature}"
: "${TASK:?Set TASK to entire, misleading, or mix}"
: "${PREFIX:?Set a unique PREFIX for this latency run}"

cd /scratch/jp09/dd9648/video-hallucination-benchmark

case "$MODEL" in
  qwen2.5-vl-7b)
    PYTHON=./.venv/bin/python
    export QWEN25_VL_MODEL_DIR=/scratch/jp09/dd9648/huggingface/models--Qwen--Qwen2.5-VL-7B-Instruct/snapshots/cc594898137f460bfe9f0759e9844b3ce807cfb5
    ;;
  llava-ov-7b)
    PYTHON=./.venv/bin/python
    export LLAVA_OV_MODEL_DIR="$(
      find /scratch/jp09/dd9648/huggingface \
        -path '*/models--llava-hf--llava-onevision-qwen2-7b-ov-hf/snapshots/*/config.json' \
        -print -quit | sed 's#/config.json$##'
    )"
    ;;
  llava-video-7b)
    PYTHON=/scratch/jp09/dd9648/.venv-llava-video/bin/python
    export LLAVA_VIDEO_MODEL_DIR=/scratch/jp09/dd9648/huggingface/LLaVA-Video-7B-Qwen2
    ;;
  *)
    echo "Unsupported MODEL=$MODEL" >&2
    exit 2
    ;;
esac

case "$METHOD" in
  base|tcd|dino_heal|season|positive_feature) ;;
  *)
    echo "Unsupported METHOD=$METHOD" >&2
    exit 2
    ;;
esac

case "$TASK" in
  entire|misleading|mix) ;;
  *)
    echo "Unsupported TASK=$TASK" >&2
    exit 2
    ;;
esac

export MODEL METHOD TASK PREFIX
export MODEL_DIR="${MODEL_DIR:-}"
export HF_HOME=/scratch/jp09/dd9648/huggingface
export HF_HUB_CACHE=/scratch/jp09/dd9648/huggingface
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONPATH=.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS="${PBS_NCPUS:-12}"

GPU_NAME="$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n1)"
echo "Node:     $(hostname)"
echo "GPU:      $GPU_NAME"
echo "Model:    $MODEL"
echo "Method:   $METHOD"
echo "Task:     eventhallusion/$TASK"
echo "Frames:   8 uniform"
echo "Batch:    1"
echo "Prefix:   $PREFIX"

if [[ "$GPU_NAME" != *H200* ]]; then
  echo "Latency protocol requires an NVIDIA H200, found: $GPU_NAME" >&2
  exit 3
fi

"$PYTHON" - <<'PY'
import os
from pathlib import Path

import yaml

method = os.environ["METHOD"]
config = {
    "name": os.environ["PREFIX"],
    "seed": 42,
    "models": [os.environ["MODEL"]],
    "methods": [method],
    "benchmarks": [{
        "name": "eventhallusion",
        "tasks": [os.environ["TASK"]],
    }],
    "sampling": "configs/sampling.yaml",
    "generation": {
        "max_new_tokens": 128,
        "do_sample": False,
        "temperature": 0.0,
        "num_beams": 1,
    },
    "output_dir": "results/raw",
    "manifest_dir": "manifests",
    # A latency run must be fresh. Resumed files mix multiple GPU processes and
    # therefore have more than one warm-up period.
    "resume": False,
}

if method == "dino_heal":
    config["method_configs"] = {"dino_heal": {"dino_device": "cuda"}}

path = Path("/tmp") / f"{os.environ['PREFIX']}.yaml"
path.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
print("Config:", path)
PY

"$PYTHON" scripts/run_benchmark.py \
  --config "/tmp/${PREFIX}.yaml" \
  --allow-unvalidated \
  --debug-errors

echo "EVENTHALLUSION LATENCY COMPLETE: $MODEL / $METHOD / $TASK"
