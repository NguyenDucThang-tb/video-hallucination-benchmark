#!/bin/bash
#PBS -P jp09
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=200GB
#PBS -l jobfs=50GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/jp09

set -euo pipefail

cd /scratch/jp09/dd9648/video-hallucination-benchmark
source .venv/bin/activate

export QWEN25_VL_MODEL_DIR=/scratch/jp09/dd9648/huggingface/models--Qwen--Qwen2.5-VL-7B-Instruct/snapshots/cc594898137f460bfe9f0759e9844b3ce807cfb5
export MODEL_DIR="$QWEN25_VL_MODEL_DIR"
export HF_HOME=/scratch/jp09/dd9648/huggingface
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONUNBUFFERED=1

: "${POINT:?POINT was not supplied}"

POINT_PADDED="$(printf '%03d' "$POINT")"
PREFIX="qwen_positive_tuning_seed42_h200_p${POINT_PADDED}"

echo "PBS job: $PBS_JOBID"
echo "Grid point: $POINT"
echo "Prefix: $PREFIX"
nvidia-smi

PYTHONPATH=. ./.venv/bin/python scripts/run_positive_feature_grid.py \
  --model qwen2.5-vl-7b \
  --subset-manifest manifests/positive_feature_tuning_seed42.json \
  --prefix "$PREFIX" \
  --start-index "$POINT" \
  --stop-index "$POINT" \
  --execute \
  --no-resume
