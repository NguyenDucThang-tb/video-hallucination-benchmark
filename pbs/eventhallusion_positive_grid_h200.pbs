#!/bin/bash
#PBS -P hn98
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l jobfs=20GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/jp09
#PBS -l wd

set -euo pipefail
: "${POINT:?Submit with qsub -v POINT=<1..109>}"

cd /scratch/jp09/dd9648/video-hallucination-benchmark
PYTHON=./.venv/bin/python
MODEL=qwen2.5-vl-7b
MODEL_DIR="$(find /scratch/jp09/dd9648/huggingface \
  -path '*/models--Qwen--Qwen2.5-VL-7B-Instruct/snapshots/*/config.json' \
  -print -quit | sed 's#/config.json$##')"
MANIFEST=manifests/eventhallusion_positive_tuning_full_seed42.json

test -f "$MODEL_DIR/config.json"
test -f "$MANIFEST"

export MODEL_DIR QWEN25_VL_MODEL_DIR="$MODEL_DIR"
export HF_HOME=/scratch/jp09/dd9648/huggingface
export HF_HUB_CACHE=/scratch/jp09/dd9648/huggingface
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONPATH=.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS="${PBS_NCPUS:-12}"

POINT_PADDED="$(printf '%03d' "$POINT")"
PREFIX="eventhallusion_positive_grid_qwen2_5_vl_7b_p${POINT_PADDED}"

echo "Node:   $(hostname)"
echo "Model:  $MODEL"
echo "Point:  $POINT"
echo "Tasks:  entire misleading mix"
echo "Frames: 8 uniform"
echo "Prefix: $PREFIX"
nvidia-smi

"$PYTHON" scripts/run_positive_feature_grid.py \
  --model "$MODEL" \
  --benchmark eventhallusion \
  --tasks entire misleading mix \
  --subset-manifest "$MANIFEST" \
  --prefix "$PREFIX" \
  --start-index "$POINT" \
  --stop-index "$POINT" \
  --saliency-device cuda \
  --birefnet-batch-size 8 \
  --execute \
  --resume

echo "EVENTHALLUSION GRID POINT COMPLETE: $MODEL / $POINT"
