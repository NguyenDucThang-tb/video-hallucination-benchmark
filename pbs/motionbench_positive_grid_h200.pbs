#!/bin/bash
#PBS -P hn98
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l jobfs=20GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/jp09
#PBS -l wd

set -euo pipefail
: "${MODEL:?MODEL is required}"
: "${POINT:?POINT is required}"

cd /scratch/jp09/dd9648/video-hallucination-benchmark

case "$MODEL" in
  qwen2.5-vl-7b)
    PYTHON=./.venv/bin/python
    MODEL_DIR="$(find /scratch/jp09/dd9648/huggingface \
      -path '*/models--Qwen--Qwen2.5-VL-7B-Instruct/snapshots/*/config.json' \
      -print -quit | sed 's#/config.json$##')"
    export QWEN25_VL_MODEL_DIR="$MODEL_DIR"
    ;;
  llava-ov-7b)
    PYTHON=./.venv/bin/python
    MODEL_DIR="$(find /scratch/jp09/dd9648/huggingface \
      -path '*/models--llava-hf--llava-onevision-qwen2-7b-ov-hf/snapshots/*/config.json' \
      -print -quit | sed 's#/config.json$##')"
    export LLAVA_OV_MODEL_DIR="$MODEL_DIR"
    ;;
  llava-video-7b)
    PYTHON=/scratch/jp09/dd9648/.venv-llava-video/bin/python
    MODEL_DIR=/scratch/jp09/dd9648/huggingface/LLaVA-Video-7B-Qwen2
    export LLAVA_VIDEO_MODEL_DIR="$MODEL_DIR"
    ;;
  *)
    echo "Unknown MODEL: $MODEL" >&2
    exit 1
    ;;
esac

test -f "$MODEL_DIR/config.json"
test -f manifests/motionbench_positive_tuning_seed42.json

export MODEL_DIR
export HF_HOME=/scratch/jp09/dd9648/huggingface
export HF_HUB_CACHE=/scratch/jp09/dd9648/huggingface
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONPATH=.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS="${PBS_NCPUS:-12}"

SAFE_MODEL="${MODEL//./_}"
SAFE_MODEL="${SAFE_MODEL//-/_}"
POINT_PADDED="$(printf '%03d' "$POINT")"
PREFIX="motionbench_positive_grid_${SAFE_MODEL}_p${POINT_PADDED}"

echo "Node:    $(hostname)"
echo "Model:   $MODEL"
echo "Point:   $POINT"
echo "Frames:  16"
echo "Records: 648 expected"
echo "Prefix:  $PREFIX"
nvidia-smi

"$PYTHON" scripts/run_positive_feature_grid.py \
  --model "$MODEL" \
  --benchmark motionbench \
  --tasks action_order location_related_motion motion_recognition motion_related_objects \
  --subset-manifest manifests/motionbench_positive_tuning_seed42.json \
  --prefix "$PREFIX" \
  --start-index "$POINT" \
  --stop-index "$POINT" \
  --max-new-tokens 16 \
  --saliency-device cuda \
  --birefnet-batch-size 8 \
  --execute \
  --resume

echo "MOTIONBENCH GRID POINT COMPLETE: $MODEL / $POINT"
