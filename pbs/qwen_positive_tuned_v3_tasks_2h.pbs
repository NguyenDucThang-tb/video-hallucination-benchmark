#!/bin/bash
#PBS -P hn98
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l jobfs=20GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/jp09
#PBS -l wd

set -euo pipefail

: "${BENCHMARK:?Missing BENCHMARK}"
: "${TASK:?Missing TASK}"

cd /scratch/jp09/dd9648/video-hallucination-benchmark

PYTHON=./.venv/bin/python
PREFIX="qwen_positive_tuned_v3_${BENCHMARK}_${TASK}"

export QWEN25_VL_MODEL_DIR=/scratch/jp09/dd9648/huggingface/models--Qwen--Qwen2.5-VL-7B-Instruct/snapshots/cc594898137f460bfe9f0759e9844b3ce807cfb5
export MODEL_DIR="$QWEN25_VL_MODEL_DIR"
export HF_HOME=/scratch/jp09/dd9648/huggingface
export HF_HUB_CACHE=/scratch/jp09/dd9648/huggingface
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONPATH=.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS="${PBS_NCPUS:-12}"

CONFIG="/tmp/${PREFIX}.yaml"

cat > "$CONFIG" <<YAML
name: ${PREFIX}
seed: 42
models: [qwen2.5-vl-7b]
methods: [positive_feature]
method_configs:
  positive_feature:
    alpha: 0.2
    alpha_s: 0.4
    beta: 0.8

benchmarks:
  - name: ${BENCHMARK}
    tasks: [${TASK}]

sampling: configs/sampling.yaml

generation:
  max_new_tokens: 32
  do_sample: false
  temperature: 0.0
  num_beams: 1

output_dir: results/raw
manifest_dir: manifests
resume: true
YAML

echo "Node:      $(hostname)"
echo "Benchmark: $BENCHMARK"
echo "Task:      $TASK"
echo "Config:    $CONFIG"

nvidia-smi

"$PYTHON" scripts/run_benchmark.py \
  --config "$CONFIG" \
  --allow-unvalidated \
  --debug-errors

echo "TASK COMPLETE: $BENCHMARK/$TASK"
